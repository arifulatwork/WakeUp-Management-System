# Copy this file to .env and fill in the values.

# false = use the real Supabase/Postgres database. true = demo data in memory.
NEXT_PUBLIC_DEMO_MODE="false"

# Supabase: Project -> Connect. Replace [PASSWORD] and the project ids.
# The app uses the pooler (port 6543):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations use the direct / session connection (port 5432):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Signs the login cookies. Use a long random value:  openssl rand -hex 32
SESSION_SECRET="PUT-A-LONG-RANDOM-VALUE-HERE"

# Password given to ALL test accounts by the seed (giuseppe, cristina, pedro, maria, joao, ivan).
SEED_PASSWORD="choose-a-password-here"

# PHONE NOTIFICATIONS (optional). Leave empty to switch them off.
# Make a key pair with:  npm run vapid   (copy both lines it prints)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
