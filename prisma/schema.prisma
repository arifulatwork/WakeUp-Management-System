// Prisma schema — WakeUp Projects Cleaning & Maintenance Platform
// Phase 1: Worker, House, CleaningTask.
// MaintenanceTicket modeled now (Phase 2) so the "report issue" button
// in the cleaner app has somewhere real to write to later — table is
// unused by the Phase 1 UI but keeps the schema stable as we grow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")  // what the running app uses (Supabase: pooler, port 6543)
  directUrl = env("DIRECT_URL")    // what migrations use (Supabase: direct, port 5432)
}

enum Area {
  CLEANING
  MAINTENANCE
}

enum CleaningStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  TO_BE_VERIFIED
  APPROVED
  WITH_ISSUE
}

enum Priority {
  YELLOW
  ORANGE
  RED
}

// Worker identity — created once at onboarding, referenced by every
// action for audit purposes ("unequivocally identified by who performed it").
model Worker {
  id        String   @id @default(cuid())
  name      String
  language  String   // e.g. "pt", "en", "es", "fr"
  area      Area
  role      String   @default("worker") // worker | manager | coordinator | admin
  createdAt DateTime @default(now())

  // Only set for manager/coordinator/admin — cleaners and maintenance
  // workers keep the no-password unique-ID flow from onboarding.
  username     String? @unique
  passwordHash String?

  // Product ordering. role "student" = joined with a group code (no username/password);
  // role "supplier" = warehouse staff. For both, `area` is just a placeholder.
  group     Group?   @relation("GroupStudents", fields: [groupId], references: [id], onDelete: SetNull)
  groupId   String?
  dietary   String[] @default([])   // names of registered DietaryRequirement rows (students)
  coordinatedGroups Group[]          @relation("GroupCoordinator")
  studentRequests   StudentRequest[] @relation("RequestStudent")
  decidedRequests   StudentRequest[] @relation("RequestDecider")
  ordersCreated     Order[]          @relation("OrderCreator")

  assignedTasks CleaningTask[] @relation("AssignedWorker")
  completedBy   CleaningTask[] @relation("CompletedByWorker")
  ticketsRaised MaintenanceTicket[] @relation("ReportedBy")
  ticketsAssigned MaintenanceTicket[] @relation("AssignedMaintenanceWorker")
  materialRequests MaterialRequest[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
}

// House — can be a permanent WakeUp property, or a temporary listing
// (Airbnb / Booking.com) with a validity window set by an admin.
model House {
  id          String    @id @default(cuid())
  name        String
  address     String
  // null = permanent house. Set both for a temporary listing.
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())

  // "status of keys" from the Ops Overview spec. Simple state machine,
  // not a full key-log/audit-trail — enough for Ops to see at a glance.
  keyStatus    String   @default("AT_OFFICE") // AT_OFFICE | WITH_CLEANER | WITH_GUEST | MISSING
  keyUpdatedAt DateTime @default(now())

  // Apartment photo / video. The (large) files live in HouseMedia so that every
  // list that includes a house stays small; these flags say whether there is one.
  hasPhoto       Boolean   @default(false)
  hasVideo       Boolean   @default(false)
  mediaUpdatedAt DateTime?
  media          HouseMedia?

  // SCHOOL (students group, the house is one single block) | TOURISM (summer, guests).
  // The same house name can exist once per mode.
  mode        String    @default("SCHOOL")
  // The name without capitals, accents and extra spaces (see lib/houseMode.ts normName).
  // UNIQUE together with mode, so the database itself refuses two identical houses even when
  // two people save at the same moment. Always set it with nameKey(name) when writing a name.
  nameKey     String
  // Tourism mode: written check-in instructions. Room photos live in HouseRoomPhoto.
  checkInText String?
  roomPhotos  HouseRoomPhoto[]

  tasks       CleaningTask[]
  tickets     MaintenanceTicket[]
  materialRequests MaterialRequest[]
  groups      Group[]

  @@unique([nameKey, mode])
}

// The apartment's cover photo and walkthrough video, stored as data URLs.
// For production, move these to object storage (S3 / R2 / Supabase) and keep a URL instead.
model HouseMedia {
  id        String   @id @default(cuid())
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId   String   @unique
  photo     String?
  video     String?
  updatedAt DateTime @updatedAt
}

// Tourism check-in guide: one photo per room, with a label (e.g. "Kitchen", "Bedroom 1").
// Stored as data URLs like HouseMedia; move to object storage in production.
model HouseRoomPhoto {
  id        String   @id @default(cuid())
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId   String
  label     String
  photo     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([houseId])
}

// "Request products or materials" from the cleaner app, and the
// "status of... products and materials" Cristina/Ops need visibility
// into. Deliberately simple — free-text items list, not a full
// inventory/stock system.
model MaterialRequest {
  id            String   @id @default(cuid())
  house         House    @relation(fields: [houseId], references: [id])
  houseId       String
  requestedBy   Worker   @relation(fields: [requestedById], references: [id])
  requestedById String
  items         String   // free text, e.g. "Bathroom disinfectant x2, bin bags"
  status        String   @default("PENDING") // PENDING | FULFILLED
  createdAt     DateTime @default(now())
  fulfilledAt   DateTime?
}

model CleaningTask {
  id               String         @id @default(cuid())
  house            House          @relation(fields: [houseId], references: [id])
  houseId          String

  scheduledDate    DateTime
  scheduledTime    String         // "10:00" — kept as string for simple display/edit
  // multi-select cleaning types, e.g. ["GENERAL","CHECKOUT"]
  cleaningTypes    String[]

  assignedWorker   Worker?        @relation("AssignedWorker", fields: [assignedWorkerId], references: [id])
  assignedWorkerId String?

  estimatedMinutes Int?
  priority         Priority       @default(YELLOW)
  nextCheckIn      DateTime?
  notes            String?
  materialsNeeded  String?

  status           CleaningStatus @default(SCHEDULED)

  // --- proof of cleaning ---
  startedAt        DateTime?
  completedAt      DateTime?
  completedBy      Worker?        @relation("CompletedByWorker", fields: [completedByWorkerId], references: [id])
  completedByWorkerId String?

  // Dynamic/flexible fields live here as JSON so Super Admin can add
  // checklist items later without a schema migration.
  // Shape: { "checklist": [{ "label": string, "done": boolean }], "photos": [url] }
  checklistData    Json           @default("{}")

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model MaintenanceTicket {
  id           String    @id @default(cuid())
  house        House     @relation(fields: [houseId], references: [id])
  houseId      String

  area         String    // room/area affected, e.g. "Bathroom"
  description  String
  priority     Priority  @default(YELLOW)
  photoUrl     String?   // photo of the problem, from the person who reported it
  afterPhotoUrl String?  // photo after the fix, from maintenance (run a migration to add this column)
  mediaData    Json?     // { photos: string[], videos: string[] } added by maintenance while working (same idea as CleaningTask.checklistData)

  reportedBy   Worker    @relation("ReportedBy", fields: [reportedById], references: [id])
  reportedById String
  reportedAt   DateTime  @default(now())

  assignedWorker   Worker? @relation("AssignedMaintenanceWorker", fields: [assignedWorkerId], references: [id])
  assignedWorkerId String?

  status       String    @default("OPEN") // OPEN | ACCEPTED | REJECTED | IN_PROGRESS | CLOSED
  startedAt    DateTime?
  materialsUsed String?
  timeSpentMinutes Int?
  closedAt     DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Who changed what, and when. Written by lib/audit.ts after every change.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  // null for the system / unknown field app
  actorName String
  actorRole String
  entity    String   // task | ticket | material | house | staff | system
  entityId  String?
  action    String   // e.g. approve, update, delete
  summary   String   // English sentence (fallback for old entries / other tools)
  template  String?  // English template with {placeholders}; translated on screen
  params    Json?    // the values for the placeholders
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One row per phone/browser that agreed to receive notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([workerId])
}

// In-app notification history: one row per person per event. Shown in the bell
// ("20 min ago", "1 hour ago") whether or not phone push is switched on.
model Notification {
  id        String    @id @default(cuid())
  worker    Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  key       String    // push text key, e.g. "ticket_new" (translated on screen)
  params    Json?     // values for the placeholders
  url       String?   // where tapping it should go
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([workerId, createdAt])
}

// Admin-editable settings (default checklist, extra task fields…). One row per setting,
// the value is JSON, so a new kind of setting never needs a migration.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}


// ====================== PRODUCT ORDERING (students / coordinators / suppliers) ======================

// A student group. Its coordinator announces `accessCode`; students sign in with that code + their name.
// One code per group. Switching codeActive off (or deleting the group) locks every student of the group out.
model Group {
  id            String   @id @default(cuid())
  name          String
  nameKey       String   @unique          // name without capitals/accents/extra spaces (lib/houseMode.ts normName)
  accessCode    String   @unique          // 8 characters, see lib/ordering.ts CODE_ALPHABET
  codeActive    Boolean  @default(true)
  memberLimit   Int?                      // how many students the coordinator allows in this group (null = no limit); only that many can join and order
  country       String?                   // country code (lib/ordering.ts COUNTRY_CODES): the group only sees/orders the products of its country + the products for all countries
  coordinator   Worker?  @relation("GroupCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  coordinatorId String?
  house         House?   @relation(fields: [houseId], references: [id], onDelete: SetNull)
  houseId       String?                   // optional: the house this group lives in
  createdAt     DateTime @default(now())

  students Worker[]         @relation("GroupStudents")
  requests StudentRequest[]
  orders   Order[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("General")
  unit        String   @default("pcs")
  brand       String?
  standardQty Int      @default(1)        // standard quantity per student per ordering round
  dietaryTags String[] @default([])       // dietary requirements this product is suitable for
  // Approved alternatives / other brands: [{ id, name, brand?, dietaryTags: string[] }]
  alternatives Json    @default("[]")
  active      Boolean  @default(true)
  // The product name in other languages: { "pt": "Leite", "es": "Leche" }. `name` stays the default / fallback.
  names       Json     @default("{}")
  photo       String?                     // catalogue photo: an "r2:photos/…" reference (or a small data URL, like the other photos)
  country     String?                     // country code this product is sold in (null = available in every country)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requestLines RequestLine[]
  orderLines   OrderLine[]
}

model DietaryRequirement {
  id          String   @id @default(cuid())
  name        String   @unique            // e.g. "Vegan" — students and products refer to it by name
  description String?
  createdAt   DateTime @default(now())
}

// A student's request (model STUDENT_REQUESTS). Approved lines are merged into the group's Order.
model StudentRequest {
  id          String   @id @default(cuid())
  group       Group    @relation(fields: [groupId], references: [id])
  groupId     String
  student     Worker   @relation("RequestStudent", fields: [studentId], references: [id])
  studentId   String
  orderDate   String                      // the ordering day, "YYYY-MM-DD"
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  decisionNote String?
  decidedBy   Worker?  @relation("RequestDecider", fields: [decidedById], references: [id])
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())

  lines RequestLine[]

  @@index([groupId, status])
  @@index([studentId])
}

model RequestLine {
  id            String  @id @default(cuid())
  request       StudentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId     String
  product       Product @relation(fields: [productId], references: [id])
  productId     String
  quantity      Int                       // what the student asked for
  standardQty   Int                       // the standard at that moment (quantity != standardQty = exception)
  exceptionReason String?
  lineStatus    String  @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedQty   Int?                      // what the coordinator allowed
  alternativeName String?                 // an approved alternative/brand chosen instead of the product
  dietaryFlag   String?                   // requirements of the student this choice does not cover
}

// One order per group per ordering day.
model Order {
  id          String   @id @default(cuid())
  group       Group    @relation(fields: [groupId], references: [id])
  groupId     String
  orderDate   String                      // "YYYY-MM-DD"
  status      String   @default("OPEN")   // OPEN | APPROVED | PREPARING | PREPARED | DISPATCHED | DELIVERED | CANCELLED
  note        String?
  createdBy   Worker   @relation("OrderCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approvedAt  DateTime?                   // sent to the supplier
  preparedAt  DateTime?
  dispatchedAt DateTime?
  deliveredAt DateTime?

  lines OrderLine[]

  @@index([groupId, orderDate])
  @@index([status])
}

model OrderLine {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  product      Product @relation(fields: [productId], references: [id])
  productId    String
  quantity     Int
  alternativeName String?                 // approved alternative/brand ordered instead
  status       String  @default("PENDING") // PENDING | PREPARED | UNAVAILABLE
  preparedQty  Int?
  substituteName String?                  // approved alternative the supplier used instead
  missingNote  String?
  preparedAt   DateTime?
}
